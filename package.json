{
  "name": "formflow",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:extension": "node scripts/build-extension.mjs",
    "build:all": "npm run build && npm run build:extension",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "test:server": "node --test server/test/*.test.mjs",
    "test": "npm run typecheck && npm run test:local && npm run test:extension && npm run test:server",
    "test:extension": "node --test extension/test/*.test.ts",
    "test:local": "node scripts/test-local.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.1",
    "@huggingface/transformers": "^4.3.2",
    "@noble/hashes": "^2.4.0",
    "busboy": "^1.6.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "idb": "^8.0.4",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.13.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.5.438",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "tesseract.js": "^7.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.24.2",
    "fake-indexeddb": "^6.2.8",
    "playwright": "^1.65.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
