PORT=8787
ALLOWED_ORIGIN=http://localhost:5173

# Server Security & Database
DATABASE_PATH=./server/formflow.db
AUTH_SECRET=dev-secret-key-change-in-production-min-32-chars

# Legacy development server only. The FormFlow extension does not use this
# backend for AI, document storage, or inference. External AI providers and
# Google Drive document storage have been removed.

# Optional legacy Google account sign-in (no Drive scope)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8787/api/auth/google/callback
